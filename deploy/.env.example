# 复制为 deploy/.env 后按部署环境调整；Compose 专用，不用于原生 Node 启动。
# Compose 会把相对卷路径按 deploy/compose.yml 所在目录解析。

# 启动时初始化状态目录，随后应用和内置 PostgreSQL 均以此 UID:GID 运行。
# 初始化后请保持 UID/GID 不变；不要对现有录像/数据库目录自动递归修改权限。
STV_UID=1000
STV_GID=1000
TZ=Asia/Shanghai
# IANA 时区，例如 America/New_York、Europe/London、Asia/Tokyo、UTC。
# 时间显示与自然日导航统一使用此值；录像索引和媒体目录仍使用 UTC。

# 单容器包含应用、PostgreSQL 与精简 FFmpeg，不包含浏览器或自动取钥。
# 默认使用 GHCR 发布镜像。需要固定版本时可改用版本标签。
STV_APP_IMAGE=ghcr.io/tchzhaoge/st-vault:latest

# data 包含私有配置和 PostgreSQL，推荐本机 SSD；数据库目录不支持 SMB/NFS。
# media 保留完整可迁移媒体库，可放机械硬盘；两个目录均需持久化。
STV_DATA_VOLUME=../data
STV_MEDIA_VOLUME=../media

# 应用保留最多 8 个 10 MiB JSONL 文件；与 Docker 输出同时保留。
STV_LOG_MAX_MB=10
STV_LOG_FILES=8

# 默认只允许本机访问。仅在可信局域网需要直连时改为 0.0.0.0，并配置防火墙。
STV_BIND_ADDRESS=127.0.0.1
STV_RELEASE_PORT=10002

# 使用HTTPS反向代理时设为1；本机HTTP测试保持0。
# 反向代理需保留Host；此项启用Secure会话Cookie。
STV_SECURE_COOKIE=0
# 首次连接来源；登录后清单、匿名状态与图片统一使用账户绑定站点。
STV_ACCOUNT_ORIGIN=https://stripchat.com

# 运行资源上限与录制策略初始值。保留 0 表示永久保留；低水位默认 2 GiB。
STV_APP_MEMORY=8g
# 留空按有效内存的三分之一自动分配共享媒体缓冲，上限 4096 MiB。
STV_INGRESS_MEMORY_MB=
# 0 表示不设置 CPU quota；仍按实际可用核心与内存规划执行池。
STV_APP_CPUS=0
# 默认自动规划。解码是独立 FFmpeg 进程，I/O 与网络使用各自并行预算。
# 解码会保留媒体/V8/数据库空间，实际并发可小于显式请求，启动日志会列出有效值。
STV_DECODE_WORKERS=
STV_IO_WORKERS=
STV_NETWORK_WORKERS=
# 留空由有效内存规划 Node heap；熟悉 Node 参数时可显式覆写。
STV_NODE_OPTIONS=
STV_POLL_MS=5000
STV_RETENTION_DAYS=0
STV_MIN_FREE_BYTES=2147483648
